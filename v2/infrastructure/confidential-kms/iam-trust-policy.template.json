{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ExactVercelWorkload",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::${AWS_ACCOUNT_ID}:oidc-provider/oidc.vercel.com/${VERCEL_TEAM_SLUG}"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "oidc.vercel.com/${VERCEL_TEAM_SLUG}:aud": "https://vercel.com/${VERCEL_TEAM_SLUG}",
          "oidc.vercel.com/${VERCEL_TEAM_SLUG}:sub": "owner:${VERCEL_TEAM_SLUG}:project:${VERCEL_PROJECT_NAME}:environment:${ENVIRONMENT}"
        }
      }
    }
  ]
}
